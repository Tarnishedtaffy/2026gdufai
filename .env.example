# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，切勿提交。
# 新增变量时同步更新本文件与 README。

# ---- 服务 ----
PORT=3000
NODE_ENV=development
TZ=Asia/Shanghai
# Compose 镜像名称；首次 GHCR 发布后可使用 ghcr.io/tarnishedtaffy/2026gdufai:sha-<完整提交 SHA>
IMAGE_NAME=gdufai:local

# ---- 存储 ----
DATABASE_PATH=./data/app.db
UPLOAD_DIR=./uploads

# ---- 鉴权（演示用，方式待定）----
APP_AUTH_TOKEN=change-me

# ---- AI 服务（服务商待定，按实际选型调整变量名）----
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
OCR_API_KEY=
ASR_API_KEY=

# ---- 通知（M4，可选）----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
QQ_BOT_WEBHOOK=
